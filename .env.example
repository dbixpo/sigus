# SIGUS — Variáveis de ambiente (cópie para .env e ajuste)
# =========================================================

FLASK_APP=run.py
FLASK_ENV=production

# Obrigatório em produção — gere uma chave segura (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua-chave-secreta-aqui

# PostgreSQL — ajuste host, user, senha e database para o servidor
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sigus
