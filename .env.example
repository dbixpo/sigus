# SIGUS — Variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o arquivo .env.
# =========================================================

FLASK_APP=run.py
FLASK_ENV=development

# Obrigatório em produção — python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui

# PostgreSQL. Senha com @ deve ir como %40 na URL.
DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/sigus

# Prefixo público (IIS e localhost). Não remova sem plano.
APPLICATION_ROOT=/sigus

# Porta local (IIS injeta HTTP_PLATFORM_PORT). Evite 5000.
SIGUS_PORT=5001

# 0 = este computador, Flask em http://localhost:5001/sigus (não injeta host de servidor).
# 1 = só no servidor, atrás do IIS. Aí preencha SIGUS_PUBLIC_HOST no .env DAQUELA máquina,
# nunca neste exemplo e nunca no Git.
SIGUS_BEHIND_PROXY=0
# SIGUS_PUBLIC_HOST=

# Consulta de paciente no SISWEB (módulo NSP). Não commitar senha.
# Pasta do robô neste computador (repositório api-consulta-usuario-sis).
SIS_CONSULTA_PATH=
SIS_USUARIO=
SIS_SENHA=
SIS_AMBIENTE=producao
SIS_SSL_VERIFY=true

# Só na máquina que publica manuais na Estante SES (scripts/pub_estante_*.py).
# ESTANTE_EMAIL=
# ESTANTE_SENHA=
