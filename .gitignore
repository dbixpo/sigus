# SIGUS — Arquivos ignorados pelo Git

# Variáveis de ambiente (credenciais)
.env

# Python (nunca commitar)
__pycache__/
*.pyc
.pytest_cache/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/

# Logs
logs/
*.log

# Dump de desenvolvimento (não commitar)
database/sigus_backup.zip
database/*.zip
database/sigus_backup.sql
database/sigus_backup_*.sql
database/sigus_dump.sql

# Planilhas de origem para importações (dados internos, não vão para o Git)
migrations/dados/

# Dump de produção SUEQ (Patrick) — dados e anexos não vão para o Git
database/sueq_data.sql
app/static/uploads/sueq/
app/static/uploads/nsp/
