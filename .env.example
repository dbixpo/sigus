# SIGUS — Variáveis de ambiente (cópie para .env e ajuste)
# =========================================================

FLASK_APP=run.py
FLASK_ENV=production

# Obrigatório em produção — gere uma chave segura (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua-chave-secreta-aqui

# PostgreSQL — ajuste host, user, senha e database para o servidor
# Senha com @ no início deve ser codificada como %40 na URL
DATABASE_URL=postgresql://sa:%40sua-senha@localhost:5432/sigus

# Porta local de desenvolvimento (evite 5000 se outro serviço já usa)
SIGUS_PORT=5001

# Consulta de paciente no SISWEB (não commitar senha — só no .env local/servidor)
# Pasta do robô: C:\Users\hardr\Documents\GitHub\api-consulta-usuario-sis
SIS_CONSULTA_PATH=C:\Users\hardr\Documents\GitHub\api-consulta-usuario-sis
SIS_USUARIO=
SIS_SENHA=
SIS_AMBIENTE=producao
SIS_SSL_VERIFY=true
